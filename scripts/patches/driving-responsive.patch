new file mode 100644
index 0000000..bcdd69f
--- /dev/null
+++ b/components/MobileSession.tsx
@@ -0,0 +1,29 @@
+import {useEffect,useState} from 'react';
+import {useTouchControls} from '../utils/device';
+
+// Fullscreen must originate in a user gesture; orientation changes alone cannot grant it.
+async function enterFullscreen() {
+  try {
+    if (!document.fullscreenElement && document.documentElement.requestFullscreen) await document.documentElement.requestFullscreen();
+    const orientation = screen.orientation as ScreenOrientation & {lock?: (mode: string) => Promise<void>};
+    if (document.fullscreenElement && orientation?.lock) await orientation.lock('landscape');
+  } catch { /* Keep the viewport-filling layout when the browser refuses. */ }
+}
+export function MobileSession() {
+  const touch = useTouchControls();
+  const [portrait,setPortrait] = useState(()=>innerHeight>innerWidth);
+  const [fullscreen,setFullscreen] = useState(false);
+  useEffect(()=>{
+    document.documentElement.dataset.touchGame=String(touch);
+    const update=()=>{setPortrait(innerHeight>innerWidth);setFullscreen(Boolean(document.fullscreenElement));};
+    const enter=()=>{if(touch)void enterFullscreen();};
+    window.addEventListener('resize',update);
+    document.addEventListener('fullscreenchange',update);
+    if(touch)document.addEventListener('pointerup',enter,{once:true});
+    return()=>{window.removeEventListener('resize',update);document.removeEventListener('fullscreenchange',update);document.removeEventListener('pointerup',enter);delete document.documentElement.dataset.touchGame;};
+  },[touch]);
+  if(!touch)return null;
+  if(portrait)return <div className="mobile-session-rotate" role="status"><strong>请旋转手机，横屏驾驶</strong><p>横屏后自动展开游戏。若画面没有旋转，请关闭手机的竖屏方向锁定。</p><button onClick={()=>void enterFullscreen()}>进入横屏游戏</button>{!document.documentElement.requestFullscreen&&<p>此浏览器会铺满可用画面；添加到主屏幕后打开，可隐藏浏览器工具栏。</p>}</div>;
+  if(!fullscreen&&document.documentElement.requestFullscreen)return <button className="mobile-session-fullscreen" onClick={()=>void enterFullscreen()}>全屏</button>;
+  return null;
+}
